{
  "openapi": "3.0.3",
  "info": {
    "title": "Vertical Vision — API & Rotas",
    "version": "2026.07.06",
    "description": "Catalogo OpenAPI de TODAS as rotas do Vertical Vision (repositorio mobile-vision-vertical-joy, sincronizado com o Lovable). Cobre paginas publicas, paginas autenticadas (layout _authenticated), endpoints server-side (IA + webhooks) e o servidor MCP embutido (personal-ia-mcp) com OAuth via Supabase. Gerado a partir do estado do repo em 06/jul/2026 (commit 75ec44d)."
  },
  "servers": [
    {
      "url": "/",
      "description": "App (TanStack Start server)"
    }
  ],
  "tags": [
    {
      "name": "app-pages-public",
      "description": "Paginas publicas (sem sessao)"
    },
    {
      "name": "app-pages-auth",
      "description": "Paginas que exigem sessao Supabase (_authenticated)"
    },
    {
      "name": "api-ai",
      "description": "Endpoints de IA autenticados por Bearer JWT do Supabase"
    },
    {
      "name": "api-webhooks",
      "description": "Webhooks internos protegidos por apikey (pg_cron / Edge)"
    },
    {
      "name": "mcp",
      "description": "Servidor MCP embutido (personal-ia-mcp) + descoberta OAuth"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase JWT (access_token)",
        "description": "Authorization: Bearer <access_token> do usuario autenticado."
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-access-token",
        "description": "Sessao Supabase no navegador. _authenticated/route.tsx roda getUser() em beforeLoad; sem sessao -> /auth."
      },
      "webhookApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Chave anon/publishable do Supabase em apikey ou x-api-key. Internamente usa service_role."
      },
      "mcpOAuth": {
        "type": "oauth2",
        "description": "OAuth 2.0 via Supabase (issuer .../auth/v1, audience 'authenticated'). Descoberta em /.well-known/oauth-protected-resource.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://bqqxvhvztzpvrjfbkcnr.supabase.co/auth/v1/authorize",
            "tokenUrl": "https://bqqxvhvztzpvrjfbkcnr.supabase.co/auth/v1/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "UIMessage": {
        "type": "object",
        "required": [
          "id",
          "role",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "text"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "audit_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "summary": {
            "type": "string"
          },
          "auto_applied": {
            "type": "boolean"
          },
          "apply_error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token/sessao ausente, malformado ou invalido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "HtmlPage": {
        "description": "Documento HTML da SPA (TanStack Start).",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Redirect": {
        "description": "Redireciona para /auth quando nao ha sessao (ou gate de onboarding)."
      }
    }
  },
